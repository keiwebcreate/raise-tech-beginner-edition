# Spring Boot の設定（/etc/taskboard/taskboard.env）。scripts/setup-server.sh が Terraform の出力から作る。
# このファイルは見本（中身の形を示すだけ）。パスワードは入れない（start.sh がパラメータストアから読む）

# 本番の設定（application-prod.yml）を読み込む
SPRING_PROFILES_ACTIVE=prod
# RDS の住所（terraform output -raw db_endpoint）。sslmode=require で暗号化してつなぐ
DB_URL=jdbc:postgresql://（RDS の住所）:5432/task_app?sslmode=require
DB_USERNAME=task_app_user
# パスワードを入れたパラメータの名前（terraform output -raw app_db_password_parameter）
DB_PASSWORD_PARAMETER=/taskboard/db/app-password
AWS_REGION=ap-southeast-2
# Java のメモリ：EC2（t4g.micro）のメモリが 1GB なので、Nginx などの分を残して抑える
JAVA_OPTS="-Xms128m -Xmx384m -XX:MaxMetaspaceSize=192m -XX:+UseSerialGC"
